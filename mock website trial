  .nav-cta:hover { background: var(--gold-dim); }
 
  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 60px;
    position: relative;
    overflow: hidden;
  }
 
  /* Left panel — forest green */
  .hero-left {
    background: var(--forest);
    padding: 6rem 5% 5rem 6%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
 
  /* DC street grid pattern — CSS only */
  .hero-left::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(212,168,71,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,168,71,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    transform: rotate(-8deg) scale(1.3);
    pointer-events: none;
  }
 
  /* Diagonal slice — right edge of left panel */
  .hero-left::after {
    content: '';
    position: absolute;
    top: 0; right: -60px; bottom: 0;
    width: 120px;
    background: var(--forest);
    clip-path: polygon(0 0, 40% 0, 100% 100%, 0 100%);
    z-index: 2;
  }
 
  .hero-left-content {
    position: relative;
    z-index: 3;
    opacity: 0;
    animation: heroIn 0.8s 0.2s cubic-bezier(0.22,1,0.36,1) forwards;
  }
 
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
 
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: heroIn 0.7s 0.4s cubic-bezier(0.22,1,0.36,1) forwards;
