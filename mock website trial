  .hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }
 
  .hero-headline {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
